<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Operant.Editor.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisible"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True"/>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4,12,4"/>
        <Setter Property="Foreground" Value="#444"/>
    </Style>

    <Style x:Key="FieldInput" TargetType="TextBox">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolbarText" TargetType="TextBox">
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusBar" TargetType="Border">
        <Setter Property="Background" Value="#F2F2F2"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
        <Setter Property="VerticalGridLinesBrush" Value="#EEE"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEE"/>
    </Style>
</ResourceDictionary>
